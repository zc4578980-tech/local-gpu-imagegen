{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Local GPU Image Generation Model Record",
  "type": "object",
  "required": [
    "schema_version", "id", "kind", "source", "license_id", "license_url",
    "license_status", "backends", "local_discovery_names", "strengths", "limitations",
    "use_cases", "styles", "recommended", "known_local", "enabled",
    "model_family", "prompt_dialect", "capabilities", "affinity", "evidence"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "id": {"type": "string", "minLength": 1},
    "kind": {"type": "string", "const": "model"},
    "source": {"type": "string", "minLength": 1},
    "license_id": {"type": ["string", "null"]},
    "license_url": {"type": ["string", "null"]},
    "license_status": {"type": "string", "enum": ["approved", "requires_user_review", "rejected"]},
    "backends": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "local_discovery_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "strengths": {"type": "array", "items": {"type": "string"}},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "use_cases": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "styles": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "recommended": {
      "type": "object",
      "required": ["resolution", "steps", "guidance", "sampler", "scheduler"],
      "properties": {
        "resolution": {
          "type": "object",
          "required": ["width", "height"],
          "properties": {
            "width": {"type": "integer", "minimum": 1},
            "height": {"type": "integer", "minimum": 1}
          },
          "additionalProperties": false
        },
        "steps": {"type": "integer", "minimum": 1},
        "guidance": {"type": "number", "minimum": 0},
        "sampler": {"type": ["string", "null"]},
        "scheduler": {"type": ["string", "null"]}
      },
      "additionalProperties": false
    },
    "known_local": {"type": "boolean"},
    "enabled": {"type": "boolean"},
    "model_family": {"type": "string", "minLength": 1},
    "workflow_template_id": {"type": ["string", "null"], "minLength": 1},
    "workflow_template_version": {"type": ["integer", "null"], "minimum": 1},
    "prompt_dialect": {
      "type": "string",
      "enum": ["natural-v1", "sd15-tags-v1"]
    },
    "capabilities": {
      "type": "object",
      "required": [
        "operations", "minimum_dimension", "maximum_dimension",
        "minimum_vram_gb", "negative_prompt"
      ],
      "properties": {
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["txt2img", "img2img", "inpaint"]}
        },
        "minimum_dimension": {"type": "integer", "minimum": 256, "maximum": 1536},
        "maximum_dimension": {"type": "integer", "minimum": 256, "maximum": 1536},
        "minimum_vram_gb": {"type": "number", "minimum": 0},
        "negative_prompt": {
          "type": "string",
          "enum": ["supported", "ignored", "unsupported"]
        }
      },
      "additionalProperties": false
    },
    "affinity": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "evidence": {
      "type": "object",
      "required": ["level", "operations"],
      "properties": {
        "level": {
          "type": "string",
          "enum": ["declared", "observed", "benchmarked"]
        },
        "operations": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["txt2img", "img2img", "inpaint"]}
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
