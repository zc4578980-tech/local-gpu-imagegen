{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local-gpu-imagegen.invalid/schemas/run-evidence.schema.json",
  "additionalProperties": false,
  "allOf": [
    {
      "else": {"not": {"required": ["two_stage"]}},
      "if": {
        "properties": {
          "route": {
            "properties": {"workflow_template_id": {"const": "sdxl-two-stage-copy-subject"}},
            "required": ["workflow_template_id"]
          }
        },
        "required": ["route"]
      },
      "then": {"required": ["two_stage"]}
    }
  ],
  "properties": {
    "backend": {"type": "object"},
    "brief_id": {"minLength": 1, "type": "string"},
    "completed_at": {"format": "date-time", "type": "string"},
    "decision_summary": {"minLength": 1, "type": "string"},
    "environment": {"type": "object"},
    "evidence_class": {"const": "real-codex-mcp-run"},
    "files": {"type": "object"},
    "host": {"type": "object"},
    "known_limitations": {"items": {"minLength": 1, "type": "string"}, "minItems": 1, "type": "array"},
    "model": {"type": "object"},
    "profile": {"minLength": 1, "type": "string"},
    "quality_status": {"const": "accepted"},
    "route": {
      "additionalProperties": false,
      "allOf": [
        {
          "else": {"not": {"required": ["control_sha256"]}},
          "if": {
            "properties": {"workflow_template_id": {"const": "sdxl-two-stage-copy-subject"}},
            "required": ["workflow_template_id"]
          },
          "then": {"required": ["control_sha256"]}
        }
      ],
      "properties": {
        "authorization_scope": {"const": "public_evidence"},
        "backend": {"enum": ["webui", "diffusers", "comfyui"], "type": "string"},
        "component_bundle": {
          "oneOf": [
            {"type": "null"},
            {
              "additionalProperties": false,
              "properties": {
                "bundle_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
                "components": {
                  "items": {
                    "additionalProperties": false,
                    "properties": {
                      "backend_model_id": {"minLength": 1, "type": "string"},
                      "byte_size": {"minimum": 1, "type": "integer"},
                      "filesystem_identity_token": {"pattern": "^model:[0-9a-f]{64}$", "type": "string"},
                      "loader_class": {"minLength": 1, "type": "string"},
                      "loader_input": {"minLength": 1, "type": "string"},
                      "role": {"enum": ["primary_model", "text_encoder", "vae"]},
                      "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
                    },
                    "required": ["role", "loader_class", "loader_input", "backend_model_id", "filesystem_identity_token", "sha256", "byte_size"],
                    "type": "object"
                  },
                  "minItems": 1,
                  "type": "array"
                },
                "schema_version": {"const": 1},
                "workflow": {
                  "additionalProperties": false,
                  "properties": {
                    "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
                    "template_id": {"minLength": 1, "type": "string"},
                    "template_version": {"minimum": 1, "type": "integer"}
                  },
                  "required": ["template_id", "template_version", "sha256"],
                  "type": "object"
                }
              },
              "required": ["schema_version", "components", "workflow", "bundle_sha256"],
              "type": "object"
            }
          ]
        },
        "component_bundle_sha256": {"pattern": "^[0-9a-f]{64}$", "type": ["string", "null"]},
        "control_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "identity_strength": {"const": "cryptographic"},
        "model_id": {"minLength": 1, "type": "string"},
        "prompt_compiler_id": {"minLength": 1, "type": "string"},
        "prompt_compiler_version": {"minimum": 1, "type": "integer"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "workflow_template_id": {"type": ["string", "null"]},
        "workflow_template_version": {"type": ["integer", "null"]}
      },
      "required": ["authorization_scope", "backend", "model_id", "sha256", "identity_strength", "workflow_template_id", "workflow_template_version", "prompt_compiler_id", "prompt_compiler_version", "component_bundle", "component_bundle_sha256"],
      "type": "object"
    },
    "run_id": {"minLength": 1, "type": "string"},
    "schema_version": {"const": 1},
    "selected_round": {"maximum": 3, "minimum": 1, "type": "integer"},
    "started_at": {"format": "date-time", "type": "string"},
    "style": {"type": ["string", "null"]},
    "two_stage": {
      "additionalProperties": false,
      "properties": {
        "base": {"$ref": "#/$defs/stageArtifact"},
        "control_sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"},
        "final": {"$ref": "#/$defs/stageArtifact"},
        "mask": {"$ref": "#/$defs/stageArtifact"},
        "pixel_preservation": {
          "additionalProperties": false,
          "properties": {
            "checked_pixels": {"minimum": 1, "type": "integer"},
            "copy_mismatched_pixels": {"const": 0},
            "mismatched_pixels": {"const": 0},
            "protected_rect": {
              "additionalProperties": false,
              "properties": {
                "height": {"minimum": 1, "type": "integer"},
                "width": {"minimum": 1, "type": "integer"},
                "x": {"minimum": 0, "type": "integer"},
                "y": {"minimum": 0, "type": "integer"}
              },
              "required": ["x", "y", "width", "height"],
              "type": "object"
            }
          },
          "required": ["protected_rect", "checked_pixels", "mismatched_pixels", "copy_mismatched_pixels"],
          "type": "object"
        },
        "stage_budget": {
          "additionalProperties": false,
          "properties": {
            "consumed": {"minimum": 2, "type": "integer"},
            "maximum": {"minimum": 2, "type": "integer"}
          },
          "required": ["maximum", "consumed"],
          "type": "object"
        },
        "subject_seed": {"maximum": 18446744073709551615, "minimum": 0, "type": "integer"}
      },
      "required": ["base", "mask", "final", "control_sha256", "subject_seed", "stage_budget", "pixel_preservation"],
      "type": "object"
    }
  },
  "required": ["schema_version", "evidence_class", "brief_id", "run_id", "host", "profile", "style", "backend", "model", "route", "environment", "started_at", "completed_at", "files", "selected_round", "quality_status", "known_limitations", "decision_summary"],
  "title": "Local GPU Imagegen run evidence",
  "type": "object",
  "$defs": {
    "stageArtifact": {
      "additionalProperties": false,
      "properties": {
        "path": {"minLength": 1, "type": "string"},
        "sha256": {"pattern": "^[0-9a-f]{64}$", "type": "string"}
      },
      "required": ["path", "sha256"],
      "type": "object"
    }
  }
}
